# Server Configuration
PORT=3000
NODE_ENV=development

# Anomaly Detection Thresholds (SLA / Baselines)
MAX_RESPONSE_TIME_MS=3000
FLAG_ZERO_RECORDS=true
ENABLE_ANOMALY_STORAGE=true

# AI / LLM Configuration
# Supports: 'gemini', 'openai', or 'heuristic' (automatic fallback if keys are missing)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Email Notification Configuration (Optional Feature 7.4)
ENABLE_EMAIL_ALERTS=false
EMAIL_PROVIDER=ethereal # Options: 'ethereal' (auto-generates preview link), 'smtp'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_RECIPIENT_EMAIL=admin@hospital.org

# File Watcher Configuration (Input Method 1)
ENABLE_FILE_WATCHER=true
WATCH_FILE_PATH=./data/incoming_responses.json
